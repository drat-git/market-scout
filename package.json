{
  "name": "market-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "scout": "node --import tsx cli/index.ts",
    "package:skills": "python3 scripts/package-skills.py",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "test:redis": "node --import tsx --test tests/integration/*.test.ts",
    "dev:redis": "node --import tsx scripts/local-redis.ts",
    "scout:live": "node --import tsx cli/live.ts",
    "dev:live": "vite --config vite.live.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
