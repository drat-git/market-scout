# Server-side live research configuration; copy to ignored .env.local.
# Never prefix secrets with VITE_. Do not paste credentials into the browser.
OPENAI_API_KEY=
AI_MODEL=gpt-6.1-terra
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_SECRET=
# API spending caps and usage quotas are not enforced, per the current product decision.
# Dashboard discovery also requires running Redis and a random SESSION_SECRET of at least 32 bytes.

# Optional development-only storage (ignored in production).
LOCAL_REDIS_URL=redis://127.0.0.1:6380
